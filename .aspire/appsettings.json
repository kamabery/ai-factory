{
  // Which database container starts, and which EF provider shelf.api uses to talk to it - the
  // AppHost forwards this value to the API so the two cannot disagree. "postgres", "sqlserver" or
  // "sqlite"; override for one run with the Database__Provider environment variable. A scaffold has
  // this baked to the provider it asked for - the other branches are not present to switch to.
  "Database": {
    "Provider": "sqlite"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="AutoFixture" />
    <PackageReference Include="AutoFixture.AutoNSubstitute" />
    <PackageReference Include="AutoFixture.Xunit3" />
    <ProjectReference Include="..\Factory.Core\Factory.Core.csproj" />
    <ProjectReference Include="..\Factory.Store\Factory.Store.csproj" />
    <ProjectReference Include="..\Factory.Cli\Factory.Cli.csproj" />
    <ProjectReference Include="..\Factory.Runner\Factory.Runner.csproj" />
    <ProjectReference Include="..\Factory.Server\Factory.Server.csproj" />
    <ProjectReference Include="..\Factory.TestGates\Factory.TestGates.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sanitized copies of real state files: embedded, so the golden tests read no files. -->
    <EmbeddedResource Include="Golden\*" LogicalName="Golden/%(Filename)%(Extension)" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

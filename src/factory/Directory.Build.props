<Project>
  <!-- Shared settings for the factory's .NET port (roadmap specs 01-12). Build output goes to the
       repo's artifacts/ folder, so the runner and the server find the CLI at a fixed path:
       artifacts/bin/Factory.Cli/debug/factory.dll -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../../artifacts</ArtifactsPath>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The ai-factory package's version (contract, "Installs"). -->
    <Version>0.3.0</Version>
  </PropertyGroup>
</Project>

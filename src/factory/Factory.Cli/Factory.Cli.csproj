<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The build output is the factory command itself: artifacts/bin/Factory.Cli/debug/factory(.exe), on PATH. -->
    <AssemblyName>factory</AssemblyName>
    <RootNamespace>Factory.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>factory</ToolCommandName>
    <!-- The dotnet tool (contract, "Installs: a checkout or the dotnet tool"). -->
    <PackageId>ai-factory</PackageId>
    <Title>AI factory</Title>
    <Description>A Claude Code software factory: ideas are grilled into specs, built, reviewed by four agents and an approver, and gated, then a human merges the PR.</Description>
    <Authors>Kurt Mabery</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kamabery/ai-factory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kamabery/ai-factory</RepositoryUrl>
    <PackageTags>claude;claude-code;agents;software-factory;dotnet-tool</PackageTags>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackRunnerServerAndAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Factory.Core\Factory.Core.csproj" />
    <ProjectReference Include="..\Factory.Store\Factory.Store.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Factory.UnitTests" />
    <InternalsVisibleTo Include="Factory.IntegrationTests" />
  </ItemGroup>
  <!--
    A tool install is one folder: the CLI, the runner and the server published side by side, and the factory root's
    files under factory/ (the plugin, templates, dashboard, github-app.json, the sign-in smoke) with .env.example.
    No deploy code: previews need a checkout until spec 16.
  -->
  <PropertyGroup>
    <_FactoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</_FactoryRoot>
    <_HostsPublishDir>$(BaseIntermediateOutputPath)pack-hosts/</_HostsPublishDir>
  </PropertyGroup>
  <Target Name="PackRunnerServerAndAssets" DependsOnTargets="Publish">
    <RemoveDir Directories="$(_HostsPublishDir)" />
    <MSBuild Projects="../Factory.Runner/Factory.Runner.csproj;../Factory.Server/Factory.Server.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_HostsPublishDir);UseAppHost=false;NoBuild=false" />
    <ItemGroup>
      <_HostFile Include="$(_HostsPublishDir)**/*" Exclude="$(_HostsPublishDir)**/*.pdb;$(_HostsPublishDir)appsettings.Development.json" />
      <_RootFile Include="$(_FactoryRoot)factory/plugin/**/*;$(_FactoryRoot)factory/templates/**/*;$(_FactoryRoot)factory/dashboard/**/*"
                 Base="$(_FactoryRoot)" />
      <_RootFile Include="$(_FactoryRoot)factory/github-app.json;$(_FactoryRoot)factory/scripts/signin-smoke.mjs" />
      <!-- The runner and server share most dependencies with the CLI (one central package set); the CLI's copy wins. -->
      <_HostFile Remove="@(_HostFile)" Condition="Exists('$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
      <TfmSpecificPackageFile Include="@(_HostFile)" PackagePath="tools/$(TargetFramework)/any/%(RecursiveDir)%(Filename)%(Extension)" />
      <TfmSpecificPackageFile Include="@(_RootFile)"
                              PackagePath="tools/$(TargetFramework)/any/$([MSBuild]::MakeRelative('$(_FactoryRoot)', '%(FullPath)'))" />
      <TfmSpecificPackageFile Include="$(_FactoryRoot).env.example" PackagePath="tools/$(TargetFramework)/any/.env.example" />
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The build output is the factory command itself: artifacts/bin/Factory.Cli/debug/factory(.exe), on PATH. -->
    <AssemblyName>factory</AssemblyName>
    <RootNamespace>Factory.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>factory</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Factory.Core\Factory.Core.csproj" />
    <ProjectReference Include="..\Factory.Store\Factory.Store.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Factory.UnitTests" />
    <InternalsVisibleTo Include="Factory.IntegrationTests" />
  </ItemGroup>
</Project>

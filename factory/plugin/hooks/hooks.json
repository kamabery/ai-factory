{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(factory:)?(spec-writer|builder|security-reviewer|code-reviewer|ux-reviewer|ui-reviewer|approver)$",
        "hooks": [
          { "type": "command", "command": "factory event" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(factory:)?(spec-writer|builder|security-reviewer|code-reviewer|ux-reviewer|ui-reviewer|approver)$",
        "hooks": [
          { "type": "command", "command": "factory event" }
        ]
      }
    ]
  }
}

# Copy to .env (gitignored). See "Idea sessions", "Targets" and "Run mode and providers" in docs/FACTORY-CONTRACT.md.

# Dashboard idea sessions in local mode (cloud mode uses Foundry instead). Only idea-turn.ps1 reads
# the key, into a local variable. It is never put in the environment, so a job's claude CLI stays on
# your subscription.
ANTHROPIC_API_KEY=
# Optional: the model for idea sessions (default claude-opus-5-5).
# FACTORY_IDEA_MODEL=claude-opus-5-5

# GitHub targets. Only factory.ps1 reads the token, and git gets it per command, never in a remote
# URL or .git/config. A fine-grained PAT on the owner's repos with Contents, Pull requests and
# Administration (to create new target repos) read/write, on All repositories. See docs/GITHUB-PAT.md.
GITHUB_TOKEN=
# The owner the dashboard suggests for a new target (a user or an organization).
GITHUB_OWNER=

# Run mode. local (the default): jobs run on the claude CLI's own login (your subscription).
# cloud: jobs and idea turns run on Claude in Microsoft Foundry, keyless through Entra ID (az login
# here, a managed identity when deployed). A deployed factory sets these in its environment, which
# wins over this file. See "Run mode and providers" in the contract and docs/FOUNDRY.md.
# FACTORY_MODE=local
# The Foundry account name (factory/infra/llm's resource_name output); cloud mode only.
# FACTORY_FOUNDRY_RESOURCE=
# Optional, cloud mode: deployment names for Claude Code's aliases (defaults shown).
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5-5
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-5-5

# Deploys: ephemeral Azure previews through HCP Terraform, between review and approve. Off until
# HCP_ORG is set. Only factory.ps1 reads these; see docs/DEPLOY.md.
# HCP_ORG=
# HCP_TOKEN=
# HCP_TEAM_TOKEN=
# HCP_AZURE_VARSET=
# AZURE_GH_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# Where the dashboard's Lessons tab proposes template fixes (owner/name).
# FACTORY_TEMPLATES_REPO=

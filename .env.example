# Copy to .env (gitignored) for the dashboard's idea sessions. See "Idea sessions" in
# docs/FACTORY-CONTRACT.md. Only idea-turn.ps1 reads the key, into a local variable. It is never
# put in the environment, so the claude CLI the runner starts stays on your subscription.
ANTHROPIC_API_KEY=
# Optional: the model for idea sessions (default claude-opus-5-5).
# FACTORY_IDEA_MODEL=claude-opus-5-5

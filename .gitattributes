# Golden state files are compared byte for byte (CRLF board.json, LF events.jsonl): never convert them.
src/factory/Factory.UnitTests/Golden/* -text
# Linux test scripts run under bash in WSL, which refuses CRLF.
factory/tests/linux/*.sh text eol=lf
# The image builds on Linux, where a CRLF line continuation breaks a RUN.
factory/container/Dockerfile text eol=lf
